{
  "name": "@yunyan-live/nest-shared",
  "version": "0.5.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./grpc": {
      "types": "./dist/grpc/index.d.ts",
      "require": "./dist/grpc/index.js",
      "default": "./dist/grpc/index.js"
    },
    "./protos/*": "./src/protos/*",
    "./session": {
      "types": "./dist/session/index.d.ts",
      "require": "./dist/session/index.js",
      "default": "./dist/session/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt/index.d.ts",
      "require": "./dist/jwt/index.js",
      "default": "./dist/jwt/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "require": "./dist/redis/index.js",
      "default": "./dist/redis/index.js"
    },
    "./dto": {
      "types": "./dist/dto/index.d.ts",
      "require": "./dist/dto/index.js",
      "default": "./dist/dto/index.js"
    },
    "./guards": {
      "types": "./dist/guards/index.d.ts",
      "require": "./dist/guards/index.js",
      "default": "./dist/guards/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "require": "./dist/pagination/index.js",
      "default": "./dist/pagination/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "require": "./dist/http/index.js",
      "default": "./dist/http/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@grpc/grpc-js": "~1.10.0",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/microservices": "^10.4.22",
    "@yunyan-live/types": "workspace:*",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
