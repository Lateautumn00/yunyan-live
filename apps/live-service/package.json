{
  "name": "@yunyan-live/live-service",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @yunyan-live/nest-shared build && node -e \"require('fs').cpSync('proto','dist/proto',{recursive:true})\" && nest start --watch",
    "build": "nest build && node -e \"require('fs').cpSync('proto','dist/proto',{recursive:true})\"",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/typeorm": "^10.0.0",
    "@yunyan-live/nest-shared": "workspace:*",
    "@grpc/grpc-js": "~1.10.0",
    "@grpc/proto-loader": "^0.8.1",
    "typeorm": "^0.3.0",
    "pg": "^8.0.0",
    "axios": "^1.0.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
