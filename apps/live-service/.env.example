# 直播微服务环境变量模板。复制为 .env 并填入真实值。
# 真实 .env 文件已被 gitignore，禁止入库。

# 数据库连接（PostgreSQL）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yunyan_live

# Janus HTTP 管理 API 地址
JANUS_URL=http://localhost:8088

# gRPC（GRPC_HOST 默认 127.0.0.1 仅本机可连；容器化部署时设为 0.0.0.0）
GRPC_HOST=127.0.0.1
GRPC_PORT=50052
# gRPC 验签共享密钥（GAP-S10b；与 gateway/yjs-ws 等调用方一致。留空=跳过验签并告警，仅限本地开发）
GRPC_SHARED_SECRET=

# GAP-S9a schema 冻结：默认 false（禁 TypeORM 动表，变更走 pnpm db:migrate）
# 仅本地开发可临时设 true；NODE_ENV=production 时设 true 会拒启动
TYPEORM_SYNC=false

# O5 监控：Prometheus /metrics 独立端口（gRPC 微服务无 HTTP listener）
METRICS_PORT=9465

# S12 审计消费者（RabbitMQ；缺省则 consumer 不启动，仅 publisher 侧丢弃）
RABBITMQ_URL=

# F9 开课提醒：提前多少分钟进入巡检窗口（默认 10；巡检间隔固定 15s）
NOTIFY_REMINDER_LEAD_MIN=10
