# 认证微服务环境变量模板。复制为 .env 并填入真实值。
# 真实 .env 文件已被 gitignore，禁止入库。

# 数据库连接（PostgreSQL）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yunyan_live

# JWT 签名密钥（必填，生产环境请改为强随机值）
JWT_SECRET=your-secret-key-here
# JWT 有效期
JWT_EXPIRES_IN=7d

# gRPC（GRPC_HOST 默认 127.0.0.1 仅本机可连；容器化部署时设为 0.0.0.0）
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
MAIL_GRPC_URL=localhost:50053

# 密码 RSA-OAEP 解密私钥（PKCS8 DER base64，pnpm gen:keys --write-env 生成，禁止入库）
PASSWORD_PRIVATE_KEY=

# O5 监控：Prometheus /metrics 独立端口（gRPC 微服务无 HTTP listener）
METRICS_PORT=9464
