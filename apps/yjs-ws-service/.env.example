# 白板 WebSocket 服务环境变量模板。复制为 .env 并填入真实值。
# 真实 .env 文件已被 gitignore，禁止入库。

# 服务监听端口
YJS_WS_PORT=50055
# JWT 签名密钥（必填，需与 Server / 其他微服务保持一致）
JWT_SECRET=your-secret-key-here

# 白板房间访问校验 gRPC（CheckRoomAccess；缺省 127.0.0.1:50052，置空整体跳过）
LIVE_GRPC_URL=127.0.0.1:50052
# gRPC 身份签名共享密钥（GAP-S10b；需与 live-service 一致，否则 CheckRoomAccess 被拒并 fail-open）
GRPC_SHARED_SECRET=

# Redis（单端登录会话校验）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
