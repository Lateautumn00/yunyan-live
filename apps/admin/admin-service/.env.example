# 管理后台微服务环境变量模板（批次 7 / GAP-F8，独立 admins 表 + 独立鉴权 audience）。
# 复制为 .env 并填入真实值。真实 .env 文件已被 gitignore，禁止入库。

# 数据库连接（PostgreSQL）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yunyan_live

# JWT 签名密钥（与 gateway 一致；admin JWT 走独立 audience=admin 与用户 token 物理隔离）
JWT_SECRET=your-secret-key-here
# JWT 有效期
JWT_EXPIRES_IN=7d

# gRPC（GRPC_HOST 默认 127.0.0.1 仅本机可连；容器化部署时设为 0.0.0.0）
GRPC_HOST=127.0.0.1
GRPC_PORT=50056
# gRPC 验签共享密钥（GAP-S10b；与 gateway 等调用方一致。留空=跳过验签并告警，仅限本地开发）
GRPC_SHARED_SECRET=

# O5 监控：Prometheus /metrics 独立端口（gRPC 微服务无 HTTP listener；现用 9464/9465/9466，本服务 9467）
METRICS_PORT=9467
