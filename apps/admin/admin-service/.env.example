# 管理后台服务环境变量模板（批次 7 / GAP-F8，单进程 HTTP：独立 admins 表 + 独立鉴权 audience）。
# 复制为 .env 并填入真实值。真实 .env 文件已被 gitignore，禁止入库。

# HTTP 监听端口（管理后台 API 直连本服务，不再经网关）
ADMIN_PORT=3100

# 数据库连接（PostgreSQL）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yunyan_live

# JWT 签名密钥（admin JWT 走独立 audience=admin 与用户 token 物理隔离）
JWT_SECRET=your-secret-key-here
# JWT 有效期
JWT_EXPIRES_IN=7d

# 封禁踢会话（Redis session:kick 广播）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 审计事件（S12 管线；留空=审计事件丢弃并告警）
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# 删除直播间时销毁 Janus 房间（失败仅告警，不阻断 DB 软删）
JANUS_URL=http://127.0.0.1:8088

# 允许的浏览器来源（Vite 直连本服务时用；默认 http://localhost:8848）
CORS_ORIGINS=http://localhost:8848

# O5 监控：Prometheus /metrics 独立端口（HTTP 服务同时也在 ADMIN_PORT/metrics 暴露）
METRICS_PORT=9467
