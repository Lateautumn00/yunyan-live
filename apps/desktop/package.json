{
  "name": "@yunyan-live/desktop",
  "version": "0.5.0",
  "private": true,
  "description": "云砚直播桌面端 (Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "smoke": "electron-vite build && node tests/e2e/smoke.mjs",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:unpack": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.14.4",
    "konva": "^10.3.1",
    "lib0": "^0.2.102",
    "pdfjs-dist": "6.3.289",
    "pinia": "^4.0.3",
    "video.js": "^8.24.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "y-protocols": "^1.0.6-1",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@yunyan-live/config": "workspace:*",
    "@yunyan-live/http": "workspace:*",
    "@yunyan-live/ipc": "workspace:*",
    "@yunyan-live/types": "workspace:*",
    "@yunyan-live/utils": "workspace:*",
    "@yunyan-live/validation": "workspace:*",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "less": "^4.9.0",
    "playwright-core": "^1.62.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  },
  "license": "MIT"
}
