# 环境模板。复制为 .env.development / .env.production 填入真实值。
# 真实 .env 文件已被 gitignore，禁止入库。
# XXXXX 替换为实际服务器 IP 或域名。

# 应用版本号（用于设备检测页展示）
VITE_VERSION=0.5.0
# Janus WebSocket 信令地址（前端推流/拉流/信令）
VITE_LIVE_SERVER=ws://XXXXX:8188/janus
# 聊天 WebSocket 地址
VITE_MESSAGE_WS=ws://XXXXX:50054
# 用户模块 API（登录/注册/信息）
VITE_USER_API=http://XXXXX:3001/user
# 直播模块 API（房间/录制）
VITE_LIVE_API=http://XXXXX:3001/live
# 应用更新资源地址（electron-updater 下载源）
VITE_UPLOAD_URL=
# 设备检测页音频测试资源地址
VITE_AUDIO_URL=
# 用户协议 PDF 地址
VITE_USER_AGREEMENT=
# 图片上传接口
VITE_UPLOAD_IMAGE_URL=http://XXXXX:3001/upload/image
# PPT 课件上传接口
VITE_UPLOAD_PPT_URL=http://XXXXX:3001/upload/ppt
# Yjs 白板协同 WebSocket 地址
VITE_YJS_WS=ws://XXXXX:50055
# 小班课人数阈值（>10 视为大班）
VITE_SMALL_CLASS_NUM=10