# 聊天 WebSocket 服务环境变量模板。复制为 .env 并填入真实值。
# 真实 .env 文件已被 gitignore，禁止入库。
# 服务监听端口
CHAT_WS_PORT=50054
# JWT 签名密钥（必填，需与 Server / 其他微服务保持一致）
JWT_SECRET=your-secret-key-here

# Redis（登录会话校验）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 消息持久化（方案 §4.7：两项同时配置才启用；只配其一 = 配置错误按关闭处理并打日志）
# PostgreSQL 连接串，如 postgresql://chat_rw:password@127.0.0.1:5432/yunyan_live
DATABASE_URL=
# RabbitMQ 连接串，如 amqp://chat_rw:password@127.0.0.1:5672
RABBITMQ_URL=
# 可选：历史查询 fail-open 超时（毫秒，默认 3000）
CHAT_HISTORY_TIMEOUT_MS=
