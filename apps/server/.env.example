# 网关服务环境变量模板。复制为 .env 填入真实值。
# 真实 .env 文件已被 gitignore，禁止入库。

# 数据库连接（PostgreSQL）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yunyan_live
# JWT 签名密钥（生产环境必须更换为强随机值）
JWT_SECRET=your-secret-key-here
# JWT 有效期
JWT_EXPIRES_IN=7d
# Janus HTTP 管理 API 地址
JANUS_URL=http://localhost:8088
# 网关 HTTP 服务端口
SERVER_PORT=3001
# 宿主机录制文件目录（Janus 转码后生成 MP4 的位置）
RECORDINGS_DIR=/home/janus/recordings
# 服务对外基础地址（文件上传回调用）
BASE_URL=http://localhost:3001
# 允许跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Janus 容器名（用于 docker exec 执行转码）
JANUS_CONTAINER=janus-gateway
# janus-pp-rec 工具路径（容器内）
JANUS_PP_REC=/opt/janus/bin/janus-pp-rec

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# LibreOffice 路径（PPT 转 PDF 阶段）
SOFFICE_PATH=/usr/bin/libreoffice

# SMTP（邮件服务）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-password
SMTP_FROM=云砚直播 <your-email@qq.com>