{
  "name": "@yunyan-live/server",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @yunyan-live/nest-shared build && nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "migration:generate": "typeorm migration:generate -d src/data-source.ts",
    "migration:run": "typeorm migration:run -d src/data-source.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "~1.10.0",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@yunyan-live/nest-shared": "workspace:*",
    "@yunyan-live/shared": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "amqplib": "^2.0.1",
    "axios": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.0.0",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
