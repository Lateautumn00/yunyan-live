# 邮件微服务环境变量模板。复制为 .env 并填入真实值。
# 真实 .env 文件已被 gitignore，禁止入库。

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP（以 QQ 邮箱为例，授权码在邮箱「设置 - 账户 - POP3/SMTP 服务」中生成）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-password
SMTP_FROM=云砚直播 <your-email@qq.com>

# gRPC（GRPC_HOST 默认 127.0.0.1 仅本机可连；容器化部署时设为 0.0.0.0）
GRPC_HOST=127.0.0.1
GRPC_PORT=50053
# gRPC 验签共享密钥（GAP-S10b；与调用方一致。留空=跳过验签并告警，仅限本地开发）
GRPC_SHARED_SECRET=

# RabbitMQ（F9 通知队列；留空则通知消费端不启动，触发侧 publisher 恒丢弃并告警）
RABBITMQ_URL=amqp://localhost:5672

# 指标抓取端口（auth=9464 live=9465 mail=9466，见 docs/research/monitoring-baseline.md）
METRICS_PORT=9466
