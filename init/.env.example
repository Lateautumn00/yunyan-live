# Janus Gateway Docker 配置
# 复制此文件为 .env 并修改配置

# 服务器公网IP（用于 ICE candidates，必填）
GATEWAY_IP=你的服务器公网IP

# STUN 服务器（用于 NAT 穿透）
STUN_SERVER=stun.l.google.com
STUN_PORT=19302

# 媒体流端口范围
RTP_PORT_RANGE=20000-20100

# PostgreSQL 口令（可选；缺省回退 postgres 以保持快速开始零配置，生产部署务必覆盖）
# 仅在 pgdata 卷首次初始化时生效，改口令不改已建库的密码
# 生成口令: openssl rand -hex 32
# POSTGRES_PASSWORD=

# RabbitMQ 消息队列（chat-ws-service 落库链路，必填——compose 以 :? 强制）
RABBITMQ_USER=chat_rw
# 生成口令: openssl rand -hex 32
RABBITMQ_PASSWORD=

# gRPC 身份签名共享密钥（GAP-S10b，必填——compose 以 :? 强制）
# 各服务以 HMAC-SHA256 签名/验签 metadata 中的 user-id，五服务需同一密钥
# 生成口令: openssl rand -hex 32
GRPC_SHARED_SECRET=

# LAN 绑定 IP：postgres/redis 的第二绑定
# - 服务器：填服务器网卡 IP（如 192.168.2.100）→ 回环 + LAN 双绑，跨机直连 .100:5432/6379
# - 本机开发（Docker Desktop/WSL）：保持留空——空值/不设均回退 127.0.0.1（引擎绑不了非回环 IP，填了容器起不来）
LAN_IP=
