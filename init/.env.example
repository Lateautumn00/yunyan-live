# Janus Gateway Docker 配置
# 复制此文件为 .env 并修改配置

# 服务器公网IP（用于 ICE candidates，必填）
GATEWAY_IP=你的服务器公网IP

# STUN 服务器（用于 NAT 穿透）
STUN_SERVER=stun.l.google.com
STUN_PORT=19302

# 媒体流端口范围
RTP_PORT_RANGE=20000-20100

# RabbitMQ 消息队列（chat-ws-service 落库链路，必填——compose 以 :? 强制）
RABBITMQ_USER=chat_rw
# 生成口令: openssl rand -hex 32
RABBITMQ_PASSWORD=
